<?xml version="1.0" encoding="utf-8"?>
<!--
  小部件初始占位布局(仅 initialLayout 用)。
  桌面在 Provider 推送数据前会先 inflate 这个布局;保持极简(单个 LinearLayout + TextView),
  降低 MIUI 桌面在进程被冻结/冷启动时 inflate 失败弹"载入窗口小部件时出现问题"的概率。
  真正内容由 ScheduleWidgetProvider 用 widget_schedule 一次性铺满。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日课表"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
